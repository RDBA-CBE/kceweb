        "content": [
          {
            "title": "Our Vision",
            "description": "To develop technically proficient and cyber-skilled professionals through a state-of-the-art, innovative, and multidisciplinary learning environment that promotes ethical practices, supports higher education and research, and empowers graduates to address contemporary and future cyber security challenges for the benefit of society",
            "image": "/images/kce/academics/cyber-security/vision.png"
          },
          {
            "title": "Our Mission",
            "list": [
              {
                "item": [
                  "To impart quality education and hands-on experience that enable aspiring engineers to excel in academic pursuits and industrial applications of emerging cyber technologies.",
                  "To foster entrepreneurial and professional competencies through collaborative Industry–Institute partnerships and a vibrant environment for research and innovation in the field of cyber security.",
                  "To create an environment that develops socially responsible citizens and empowers them to promote safe, ethical, and secure use of technology for the benefit of society."
                ]
              }
            ],
            "image": "/images/kce/academics/cyber-security/mission.png"
          }
