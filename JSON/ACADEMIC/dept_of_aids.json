            "image": "/images/kce/academics/ai/vision.png"
          },
          {
            "title": "Our Mission",
            "list": [
              {
                "item": [
                  "To strengthen collaboration with industry partners and produce graduates equipped with real-world competencies and future-ready skills.",
                  "To promote a multidisciplinary, research-oriented, and innovation-driven learning environment.",
                  "To foster lifelong learning and uphold strong ethical values and professional standards."
                ]
              }
            ],
